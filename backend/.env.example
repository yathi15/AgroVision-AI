# Optional PostgreSQL URL. Leave unset to use local SQLite.
# DATABASE_URL=postgresql://user:password@localhost:5432/agrovision

# Keep your existing API keys here if you use these services.
GROQ_API_KEY=
CEDA_API_KEY=
DATA_GOV_IN_API_KEY=

# Generate a private random value for JWT_SECRET_KEY.
JWT_SECRET_KEY=

# Comma-separated frontend origins. Use your deployed frontend URL in production.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
